{
  "name": "crm-moleculer-customer-reports",
  "version": "1.0.0",
  "description": "My Moleculer microservices project",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && ts-node ./node_modules/moleculer/bin/moleculer-runner.js --hot --repl --config dist/moleculer.config.js dist/services/**/*.service.js",
    "cli": "moleculer connect NATS",
    "start": "tsc && moleculer-runner dist/services",
    "lint": "eslint --ext .js,.ts .",
    "dc:up": "docker-compose up --build -d",
    "dc:down": "docker-compose down"
  },
  "keywords": [
    "microservices",
    "moleculer"
  ],
  "author": "Amalya",
  "devDependencies": {
    "@types/bluebird": "^3.5.36",
    "@types/node": "^10.17.50",
    "@typescript-eslint/eslint-plugin": "^2.12.0",
    "@typescript-eslint/parser": "^2.12.0",
    "eslint": "^6.8.0",
    "eslint-plugin-chai-friendly": "^0.6.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-optimize-regex": "^1.2.0",
    "eslint-plugin-prefer-arrow": "^1.1.7",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-sort-destructure-keys": "^1.3.5",
    "moleculer-repl": "^0.5.3",
    "ts-node": "^7.0.1",
    "typescript": "^3.2.2"
  },
  "dependencies": {
    "dotenv": "^10.0.0",
    "moleculer": "0.13.3",
    "moleculer-db": "^0.8.14",
    "moleculer-db-adapter-mongoose": "^0.8.10",
    "mongoose": "^5.13.9",
    "nats": "^1.4.12"
  },
  "engines": {
    "node": ">= 8.x.x"
  }
}
